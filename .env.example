# Copy to .env and fill in. Never commit .env. Every key here has a free tier.

# --- Database. Default is a local SQLite file so everything runs in Colab. ---
# For SQL Server in Docker (infra/docker-compose.yml), use:
# DATABASE_URL=mssql+pyodbc://sa:YourStrong!Passw0rd@localhost:1433/creditlens?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
DATABASE_URL=sqlite:///creditlens.db

# --- LLM providers (milestone 3 onward). The gateway tries LLM_PRIMARY, then LLM_FALLBACKS in order. ---
GEMINI_API_KEY=
GROQ_API_KEY=
LLM_PRIMARY=gemini/gemini-3.5-flash-lite
LLM_FALLBACKS=groq/openai/gpt-oss-20b,ollama/llama3.2
LLM_RPM=10
# LLM_OFFLINE=1 answers from the cache or a stub: use it in CI, or when the room has no quota left.
LLM_OFFLINE=0
LLM_CACHE=1

# --- Tracing (Langfuse self-hosted via docker compose, or Langfuse Cloud free project) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# --- Graph (Neo4j AuraDB Free, or docker compose --profile retrieval). Blank = NetworkX in memory. ---
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# --- Vector DB (blank = Qdrant in memory). QDRANT_URL=http://localhost:6333 for Docker. ---
QDRANT_URL=
QDRANT_API_KEY=
PINECONE_API_KEY=

# --- API auth (mock JWT for the workshop) ---
JWT_SECRET=change-me-for-the-workshop

# --- Jira Cloud Free (blank = mock Jira in data/cache/jira.json) ---
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=CREDIT

# --- Legacy systems (milestone 7). Blank = SQLite and HTTP mocks. ---
ORACLE_DSN=
ORACLE_USER=
ORACLE_PASSWORD=
SOAP_WSDL_URL=http://localhost:8001/?wsdl

# --- Slack (Socket Mode: no public URL needed) ---
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_APPROVALS_CHANNEL=#credit-approvals
# Who may click Approve: Slack member id -> bank user id. Only a head_of_credit is accepted.
# Example: SLACK_USER_MAP=U0ABCDEF12:U05
SLACK_USER_MAP=

# --- MLOps ---
MLFLOW_TRACKING_URI=mlruns
